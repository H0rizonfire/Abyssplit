<Window x:Class="AbyssusTimer.App.Windows.TermsOfUseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Abyssplit — Terms of Use"
        SizeToContent="Height" Width="480" MinHeight="300" MaxHeight="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Border Background="#17211D" BorderBrush="#3A4A44" BorderThickness="1" CornerRadius="8" Padding="24">
        <StackPanel>
            <TextBlock Text="Terms of Use" Foreground="#C98F3F" FontSize="18" FontWeight="Bold" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380" Margin="0,14,0,0">
                <TextBlock x:Name="TermsText" Foreground="#ECE3D0" FontSize="12" TextWrapping="Wrap" LineHeight="19" />
            </ScrollViewer>

            <StackPanel x:Name="AcceptDeclineRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Decline &amp; Exit" Padding="14,8" FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                        Background="#17211D" Foreground="#E36A6A" BorderBrush="#7A2E2E" BorderThickness="1"
                        Click="Decline_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#7A2E2E" />
                                    <Setter Property="Foreground" Value="#ECE3D0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Accept" Padding="18,8" FontSize="12" Cursor="Hand" FontWeight="Bold"
                        Background="#C98F3F" Foreground="#17211D" BorderBrush="#C98F3F" BorderThickness="1"
                        Click="Accept_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#E3B06A" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <StackPanel x:Name="CloseRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0" Visibility="Collapsed">
                <Button Content="Close" Padding="18,8" FontSize="12" Cursor="Hand"
                        Background="#17211D" Foreground="#ECE3D0" BorderBrush="#3A4A44" BorderThickness="1"
                        Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#1F2A26" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
