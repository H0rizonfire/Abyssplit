<Window x:Class="AbyssusTimer.App.Windows.ConfirmDeletePersonalBestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete Personal Best?"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False">
    <Border Background="#17211D" BorderBrush="#7A2E2E" BorderThickness="2" CornerRadius="8" Padding="24" MinWidth="360" MaxWidth="440">
        <StackPanel>
            <TextBlock Text="Delete Your Personal Best?" Foreground="#ECE3D0" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock x:Name="CurrentPbText" Foreground="#8A9994" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
            <TextBlock Text="This permanently deletes your recorded PB time. It cannot be recovered."
                       Foreground="#E36A6A" FontWeight="Bold" FontSize="13" Margin="0,14,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="RevertText" Foreground="#56635E" FontStyle="Italic" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Padding="14,8" FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                        Background="#17211D" Foreground="#ECE3D0" BorderBrush="#3A4A44" BorderThickness="1"
                        Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#1F2A26" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="DeleteButton" Content="Delete PB" Padding="14,8" FontSize="12" Cursor="Hand"
                        Background="#17211D" Foreground="#E36A6A" BorderBrush="#7A2E2E" BorderThickness="1"
                        Click="Delete_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#7A2E2E" />
                                    <Setter Property="Foreground" Value="#ECE3D0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
