<Window x:Class="AbyssusTimer.App.Windows.ConfiguratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:engine="clr-namespace:AbyssusTimer.App.Engine"
        xmlns:theme="clr-namespace:AbyssusTimer.App.Theme"
        Title="Abyssplit"
        Icon="/Assets/AppIcon.ico"
        Width="480" SizeToContent="Height" MinHeight="300" MaxHeight="640"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="theme:UiRole.Name" Value="SectionHeader" />
            <Setter Property="Foreground" Value="{StaticResource BrassBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>
        <Style x:Key="TimerCard" TargetType="Border">
            <Setter Property="theme:UiRole.Name" Value="TimerCard" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="10,8" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TimerLabel" TargetType="TextBlock">
            <Setter Property="theme:UiRole.Name" Value="TimerLabel" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TimerValue" TargetType="TextBlock">
            <Setter Property="theme:UiRole.Name" Value="TimerValue" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToggleRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="MaxHeight" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{StaticResource BrassLightBrush}" CornerRadius="2" Margin="1,0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource RoundScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource PressedSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemedToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrassBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrassBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel Background="{TemplateBinding Background}">
                            <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Background="Transparent" Margin="20,12,20,0" />
                            <ContentPresenter ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="12,8" Margin="0,0,4,0">
                            <ContentPresenter x:Name="HeaderText" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{StaticResource TextMutedBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrassBrush}" />
                                <Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="{StaticResource BrassBrush}" />
                                <Setter TargetName="HeaderText" Property="TextElement.FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderText" Property="TextElement.Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="{StaticResource HairlineBrush}" CornerRadius="2" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="{StaticResource BrassBrush}" CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="{StaticResource TextPrimaryBrush}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatch" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorPickerSwatch" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Custom color..." />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource TextPrimaryBrush}" BorderThickness="1" CornerRadius="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="StatusBadgeText" TargetType="TextBlock">
            <Setter Property="theme:UiRole.Name" Value="StatusBadge" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="20">
                            <Border x:Name="Track" CornerRadius="10" Background="{StaticResource TextDimBrush}" />
                            <Grid x:Name="Knob" Width="16" Height="16" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse Fill="{StaticResource TextPrimaryBrush}" />
                                <Path x:Name="CheckGlyph" Data="M 3,8 L 6.5,11.5 L 13,4"
                                      Stroke="#17211D" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Opacity="0" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource BrassBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                                <Setter TargetName="CheckGlyph" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrassBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,6,22,6" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="None">
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        Margin="0,2,0,0">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True" MaxHeight="240">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="MainTabBiomeGroupTemplate" DataType="{x:Type engine:BiomeGroupViewModel}">
            <StackPanel Margin="0,8,0,0">
                <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="2,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock theme:UiRole.Name="MainBiomeLabel" Grid.Column="0" Text="{Binding BiomeName}" Foreground="{StaticResource BrassBrush}" FontWeight="Bold" FontSize="13" />
                        <TextBlock theme:UiRole.Name="MainBiomeTime" Grid.Column="1" Text="{Binding TotalTimeText}" Foreground="{StaticResource BrassBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="13" />
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Depths}" Margin="12,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type engine:DepthRowViewModel}">
                            <StackPanel>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock theme:UiRole.Name="MainDepthLabel" Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="MainDepthDelta" Grid.Column="1" Text="{Binding DeltaText}"
                                               Foreground="{Binding DeltaSeverity, Converter={StaticResource DeltaSeverityToBrushConverter}}"
                                               FontFamily="Consolas" FontSize="12" Margin="0,0,10,0"
                                               Visibility="{Binding DeltaText, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
                                    <TextBlock theme:UiRole.Name="MainDepthTime" Grid.Column="2" Text="{Binding TimeText}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" Margin="0,0,10,0" />
                                    <TextBlock theme:UiRole.Name="MainDepthStatus" Grid.Column="3" Text="{Binding StatusText}" Foreground="{StaticResource ToxicBrush}" FontSize="12" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rooms}" Margin="16,0,0,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type engine:RoomRowViewModel}">
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock theme:UiRole.Name="MainRoomLabel" Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                                <TextBlock theme:UiRole.Name="MainRoomTime" Grid.Column="1" Text="{Binding TimeText}" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="11" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,36,20,0">
            <TextBlock theme:UiRole.Name="AppTitle">
                <Run Text="ABYSSPLIT" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrassBrush}" />
                <Run Text="{Binding AppVersionText, Mode=OneTime}" FontSize="11" Foreground="{StaticResource TextDimBrush}" BaselineAlignment="Center" />
            </TextBlock>
            <DockPanel Margin="0,4,0,0">
                <ComboBox DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="70"
                          ItemsSource="{Binding AllPlayerCounts}" SelectedItem="{Binding ActivePlayerCount, Mode=TwoWay}"
                          IsEnabled="{Binding CanChangeCategory}" />
                <ComboBox DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="150" Margin="8,0,8,0"
                          ItemsSource="{Binding AllCategories}" SelectedItem="{Binding ActiveCategory, Mode=TwoWay}"
                          IsEnabled="{Binding CanChangeCategory}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource RunCategoryToDisplayNameConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusBadge}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}"
                            Visibility="{Binding IsAttached, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="Waiting for Abyssus" Style="{StaticResource StatusBadgeText}" Foreground="{StaticResource TextDimBrush}" />
                    </Border>
                    <Border Style="{StaticResource StatusBadge}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource ToxicBrush}"
                            Visibility="{Binding IsAttached, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Attached" Style="{StaticResource StatusBadgeText}" Foreground="{StaticResource ToxicBrush}" />
                    </Border>
                    <Border Style="{StaticResource StatusBadge}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BrassBrush}"
                            Visibility="{Binding IsInRun, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="In Run" Style="{StaticResource StatusBadgeText}" Foreground="{StaticResource BrassBrush}" />
                    </Border>
                    <Border Style="{StaticResource StatusBadge}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource TextMutedBrush}"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Loading" Style="{StaticResource StatusBadgeText}" Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                    <Border Style="{StaticResource StatusBadge}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource TealGlowBrush}"
                            Visibility="{Binding IsCutscenePlaying, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Cutscene" Style="{StaticResource StatusBadgeText}" Foreground="{StaticResource TealGlowBrush}" />
                    </Border>
                    <Border Style="{StaticResource StatusBadge}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource WarningBrush}"
                            Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Paused" Style="{StaticResource StatusBadgeText}" Foreground="{StaticResource WarningBrush}" />
                    </Border>
                </StackPanel>
            </DockPanel>

            <Border x:Name="UpdateBanner" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BrassBrush}" BorderThickness="1"
                    CornerRadius="4" Margin="0,10,0,0" Padding="12,8"
                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <Button theme:UiRole.Name="RowButton" DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource ThemedButton}" Padding="10,4" FontSize="11" Click="DismissUpdateBanner_Click" />
                    <Button theme:UiRole.Name="RowButton" DockPanel.Dock="Right" Content="Update" Style="{StaticResource ThemedButton}" Padding="10,4" FontSize="11" Margin="0,0,8,0" Click="OpenLatestRelease_Click" />
                    <TextBlock theme:UiRole.Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12">
                        <Run Text="A newer version (v" /><Run Text="{Binding LatestVersionText, Mode=OneWay}" /><Run Text=") is available — times recorded on an older version may not be accepted for leaderboard submission." />
                    </TextBlock>
                </DockPanel>
            </Border>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                    CornerRadius="4" Margin="0,10,0,0" Padding="12,8"
                    Visibility="{Binding IsJoinedMidRun, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock theme:UiRole.Name="BannerText" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12">
                    <Run Text="Joined mid-run: " FontWeight="Bold" /><Run Text="Abyssplit was opened (or the game attached) while a run was already going, so this run isn't being timed — only IGT moves, and it won't stop at the end. Your next run from the lobby will be timed normally." />
                </TextBlock>
            </Border>

            <Border x:Name="GameMismatchBanner" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1"
                    CornerRadius="4" Margin="0,10,0,0" Padding="12,8"
                    Visibility="{Binding IsPossibleGameMismatch, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <Button theme:UiRole.Name="RowButton" DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource ThemedButton}" Padding="10,4" FontSize="11" Click="DismissGameMismatchBanner_Click" />
                    <TextBlock theme:UiRole.Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12">
                        <Run Text="Possible game/timer mismatch: " /><Run Text="{Binding GameMismatchDetailText, Mode=OneWay}" /><Run Text=" Times recorded right now may be inaccurate — see Report a Bug (Settings tab) if this keeps happening." />
                    </TextBlock>
                </DockPanel>
            </Border>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Main">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="12,8" Margin="0,0,0,16"
                                Visibility="{Binding IsAttached, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock theme:UiRole.Name="BannerText" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12">
                                <Run Text="Waiting for Abyssus: " FontWeight="Bold" /><Run Text="start the game and Abyssplit finds it on its own (Steam or PC Game Pass). Timing starts by itself when you begin a run from the lobby — there's nothing to press." />
                            </TextBlock>
                        </Border>
                        <TextBlock Text="Timers — click to choose the overlay's primary timer" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource TimerCard}" Cursor="Hand" Tag="Raw" MouseLeftButtonDown="TimerCard_Click"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding IsInRun, Converter={StaticResource InverseBoolConverter}}"
                                    Visibility="{Binding ShowRawTimer, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="IGT" Style="{StaticResource TimerLabel}" />
                                    <TextBlock Text="{Binding RawRunTimeText}" Style="{StaticResource TimerValue}"
                                               Foreground="{Binding SelectedPrimaryTimer, Converter={StaticResource PrimaryTimerToBrushConverter}, ConverterParameter=Raw}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TimerCard}" Cursor="Hand" Tag="LoadFree" MouseLeftButtonDown="TimerCard_Click"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding IsInRun, Converter={StaticResource InverseBoolConverter}}"
                                    Visibility="{Binding ShowLoadFreeTimer, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="LOAD-FREE" Style="{StaticResource TimerLabel}" />
                                    <TextBlock Text="{Binding LoadFreeTimeText}" Style="{StaticResource TimerValue}"
                                               Foreground="{Binding SelectedPrimaryTimer, Converter={StaticResource PrimaryTimerToBrushConverter}, ConverterParameter=LoadFree}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource TimerCard}" Cursor="Hand" Tag="LoadCutsceneFree" MouseLeftButtonDown="TimerCard_Click"
                                    IsEnabled="{Binding IsInRun, Converter={StaticResource InverseBoolConverter}}"
                                    Visibility="{Binding ShowLoadCutsceneFreeTimer, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="LOAD+CUTSCENE-FREE" Style="{StaticResource TimerLabel}" />
                                    <TextBlock Text="{Binding LoadCutsceneFreeTimeText}" Style="{StaticResource TimerValue}"
                                               Foreground="{Binding SelectedPrimaryTimer, Converter={StaticResource PrimaryTimerToBrushConverter}, ConverterParameter=LoadCutsceneFree}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border Background="{StaticResource SurfaceBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,16,0,0"
                                Visibility="{Binding IsAllBossesView, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AllBossesAllDefeated}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource ToxicBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock theme:UiRole.Name="BossesProgress" Text="{Binding AllBossesProgressText}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AllBossesAllDefeated}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource ToxicBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock theme:UiRole.Name="BossesRemaining" Text="{Binding AllBossesRemainingText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                                           Visibility="{Binding AllBossesRemainingText, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
                                <TextBlock theme:UiRole.Name="Hint" Text="Counts a boss once you leave its depth. Mini bosses and the Royal Heralds aren't tracked."
                                           Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Splits · Personal Best" Style="{StaticResource SectionHeader}" />
                        <StackPanel Visibility="{Binding IsAllWeaponView, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock theme:UiRole.Name="EmptyState" Text="Your splits appear here once a run starts." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SplitGroups.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding SplitGroups}" ItemTemplate="{StaticResource MainTabBiomeGroupTemplate}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsAllWeaponView, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding WeaponGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type engine:WeaponGroupViewModel}">
                                        <StackPanel Margin="0,10,0,0" Opacity="{Binding RowOpacity}">
                                            <Border BorderBrush="{StaticResource BrassBrush}" BorderThickness="0,0,0,1" Padding="2,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock theme:UiRole.Name="WeaponName" Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" />
                                                    <TextBlock theme:UiRole.Name="WeaponNote" Grid.Column="1" Text="{Binding NoteText}" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="11" VerticalAlignment="Center"
                                                               Visibility="{Binding NoteText, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
                                                    <TextBlock theme:UiRole.Name="WeaponTime" Grid.Column="2" Text="{Binding TimeText}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="14" />
                                                </Grid>
                                            </Border>
                                            <TextBlock theme:UiRole.Name="PlayingNow" Text="Playing now" Foreground="{StaticResource BrassBrush}" FontSize="10" Margin="2,2,0,0"
                                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <ItemsControl ItemsSource="{Binding BiomeGroups}" ItemTemplate="{StaticResource MainTabBiomeGroupTemplate}" Margin="12,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border BorderBrush="{StaticResource BrassBrush}" BorderThickness="0,0,0,1" Padding="2,4" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock theme:UiRole.Name="BetweenRunsLabel" Grid.Column="0" Text="Between runs" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,8,0" />
                                    <TextBlock theme:UiRole.Name="WeaponNote" Grid.Column="1" Text="post-kill and lobby, loading removed" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock theme:UiRole.Name="BetweenRunsTime" Grid.Column="2" Text="{Binding AllWeaponBetweenRunsText}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="14" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="2,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock theme:UiRole.Name="AttemptTotalLabel" Grid.Column="0" Foreground="{StaticResource BrassBrush}" FontWeight="Bold" FontSize="13">
                                        <Run Text="Attempt total · " /><Run Text="{Binding AllWeaponProgressText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock theme:UiRole.Name="AttemptTotalTime" Grid.Column="1" Text="{Binding AllWeaponTotalText}" Foreground="{StaticResource BrassBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="13" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <TextBlock theme:UiRole.Name="SummaryLine" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="11" Margin="0,10,0,0">
                            <Run Text="Best full-run time: " />
                            <Run Text="{Binding BestRunTimeText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock theme:UiRole.Name="SummaryLine" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="11" Margin="0,2,0,0">
                            <Run Text="Sum of Best: " />
                            <Run Text="{Binding SumOfBestText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock theme:UiRole.Name="SummaryLine" Text="{Binding SessionStatsText, Mode=OneWay}"
                                   Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="11" Margin="0,2,0,0" />
                        <StackPanel Visibility="{Binding ShowPreviousSegment, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock theme:UiRole.Name="SummaryLine" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="11" Margin="0,2,0,0"
                                       Visibility="{Binding PreviousRunTimeText, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}">
                                <Run Text="Previous run: " />
                                <Run Text="{Binding PreviousRunTimeText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Reset Run" Style="{StaticResource ThemedButton}" Margin="0,0,8,0" Click="ResetRun_Click"
                                    IsEnabled="{Binding IsInRun, Converter={StaticResource InverseBoolConverter}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="History">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Attempt History" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                        <TextBlock theme:UiRole.Name="EmptyState" Text="No runs recorded yet for this category." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="11"
                                   Visibility="{Binding AllHistoricalRuns, Converter={StaticResource EmptyCollectionToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding AllHistoricalRuns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type engine:HistoricalRunOption}">
                                    <Border Style="{StaticResource ToggleRow}" Cursor="Hand" Tag="{Binding Index}"
                                            MouseLeftButtonDown="HistoryRow_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock theme:UiRole.Name="HistoryRunLabel" Text="{Binding DateText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock theme:UiRole.Name="HistoryRunResult" Text="{Binding ResultText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button theme:UiRole.Name="CompactButton" Grid.Column="1" Content="Compare"
                                                    Padding="8,4" FontSize="10" Margin="0,0,6,0"
                                                    Tag="{Binding Index}" Click="HistoryRowCompare_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ThemedButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource IndicesEqualConverter}">
                                                                        <Binding Path="DataContext.ActiveSpecificRunIndex"
                                                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                        <Binding Path="Index" />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Background" Value="{StaticResource BrassBrush}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource BrassBrush}" />
                                                                <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}" />
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button theme:UiRole.Name="CompactButton" Grid.Column="2" Content="Share" Style="{StaticResource ThemedButton}"
                                                    Padding="8,4" FontSize="10" Margin="0,0,6,0"
                                                    Tag="{Binding Index}" Click="HistoryRowShare_Click" />
                                            <Button theme:UiRole.Name="CompactButton" Grid.Column="3" Content="Copy" Style="{StaticResource ThemedButton}"
                                                    Padding="8,4" FontSize="10" Margin="0,0,6,0"
                                                    Tag="{Binding Index}" Click="HistoryRowCopy_Click" />
                                            <Button theme:UiRole.Name="CompactButton" Grid.Column="4" Content="Delete" Style="{StaticResource ThemedButton}"
                                                    Padding="8,4" FontSize="10"
                                                    BorderBrush="{StaticResource DangerBrush}" Foreground="{StaticResource DangerTextBrush}"
                                                    Tag="{Binding Index}" Click="HistoryRowDelete_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Visibility="{Binding AllHistoricalRuns, Converter={StaticResource NonEmptyCollectionToVisibilityConverter}}">
                        <TextBlock Text="Details" Style="{StaticResource SectionHeader}" />
                        <TextBlock theme:UiRole.Name="EmptyState" Text="Select a run above to see its splits." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedRunHistoryDetailSummary}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock theme:UiRole.Name="DetailSummary" Text="{Binding SelectedRunHistoryDetailSummary}" Foreground="{StaticResource BrassBrush}" FontWeight="Bold" FontSize="12"
                                   Visibility="{Binding SelectedRunHistoryDetailSummary, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
                        <TextBlock theme:UiRole.Name="DetailInfo" Text="{Binding SelectedRunHistoryDetailInfo}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding SelectedRunHistoryDetailInfo, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
                        <ItemsControl ItemsSource="{Binding SelectedRunHistoryDetailRows}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type engine:RunHistoryDetailRow}">
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock theme:UiRole.Name="DetailLabel" Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                        <TextBlock theme:UiRole.Name="DetailTime" Grid.Column="1" Text="{Binding TimeText}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Stats">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" Grid.IsSharedSizeScope="True">
                        <TextBlock Text="Per-Location Stats" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <TextBlock theme:UiRole.Name="Hint" Text="Best/average/worst segment time at each location, across every attempt that actually cleared it. Consistency (σ) is lower for a steadier time, higher for a wider spread."
                                   Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock theme:UiRole.Name="EmptyState" Text="No completed segments recorded yet for this category." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="11"
                                   Visibility="{Binding StatsPerLocationRows, Converter={StaticResource EmptyCollectionToVisibilityConverter}}" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PLLocation" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PLAttempts" MinWidth="20" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PLBest" MinWidth="20" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PLAvg" MinWidth="20" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PLWorst" MinWidth="20" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="PLStdDev" MinWidth="20" />
                            </Grid.ColumnDefinitions>
                            <TextBlock theme:UiRole.Name="TableHeader" Grid.Column="0" Text="Location" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,16,0" />
                            <TextBlock theme:UiRole.Name="TableHeader" Grid.Column="1" Text="Attempts" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,14,0" />
                            <TextBlock theme:UiRole.Name="TableHeader" Grid.Column="2" Text="Best" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,14,0" />
                            <TextBlock theme:UiRole.Name="TableHeader" Grid.Column="3" Text="Avg" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,14,0" />
                            <TextBlock theme:UiRole.Name="TableHeader" Grid.Column="4" Text="Worst" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,0,14,0" />
                            <TextBlock theme:UiRole.Name="TableHeader" Grid.Column="5" Text="σ" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"
                                       ToolTip="Consistency (standard deviation) across every cleared attempt at this location" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding StatsPerLocationRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type engine:LocationStatsRow}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PLLocation" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PLAttempts" MinWidth="20" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PLBest" MinWidth="20" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PLAvg" MinWidth="20" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PLWorst" MinWidth="20" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PLStdDev" MinWidth="20" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock theme:UiRole.Name="TableLabel" Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,16,0" />
                                        <TextBlock theme:UiRole.Name="TableNumber" Grid.Column="1" Text="{Binding Attempts}" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                        <TextBlock theme:UiRole.Name="TableNumber" Grid.Column="2" Text="{Binding BestText}" Foreground="{StaticResource ToxicBrush}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                        <TextBlock theme:UiRole.Name="TableNumber" Grid.Column="3" Text="{Binding AverageText}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                        <TextBlock theme:UiRole.Name="TableNumber" Grid.Column="4" Text="{Binding WorstText}" Foreground="{StaticResource DangerTextBrush}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" Margin="0,0,14,0" />
                                        <TextBlock theme:UiRole.Name="TableNumber" Grid.Column="5" Text="{Binding ConsistencyText}" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="PB Progression" Style="{StaticResource SectionHeader}" Margin="0,20,0,4" />
                        <DockPanel Margin="0,0,0,8">
                            <ComboBox DockPanel.Dock="Right" MinWidth="60" VerticalAlignment="Center"
                                      ItemsSource="{Binding AllPbChartRunCounts}" SelectedItem="{Binding PbChartRunCount, Mode=TwoWay}" />
                            <TextBlock theme:UiRole.Name="FieldLabel" DockPanel.Dock="Right" Text="Runs shown:" Foreground="{StaticResource TextDimBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,6,0" />
                            <TextBlock theme:UiRole.Name="Hint" Text="Chart: your most recent completed runs, oldest first — green dots set a new PB. List: every PB." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock theme:UiRole.Name="EmptyState" Text="No completed runs recorded yet for this category." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="11"
                                   Visibility="{Binding StatsPbProgressionRows, Converter={StaticResource EmptyCollectionToVisibilityConverter}}" />
                        <Grid Margin="0,0,0,12" Visibility="{Binding StatsPbProgressionChartPoints, Converter={StaticResource NonEmptyCollectionToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Height="60" Margin="0,0,8,0">
                                <TextBlock theme:UiRole.Name="ChartAxis" Text="{Binding StatsPbProgressionChartMaxTimeText}" Foreground="{StaticResource TextDimBrush}"
                                           FontFamily="Consolas" FontSize="9" VerticalAlignment="Top" />
                                <TextBlock theme:UiRole.Name="ChartAxis" Text="{Binding StatsPbProgressionChartMinTimeText}" Foreground="{StaticResource TextDimBrush}"
                                           FontFamily="Consolas" FontSize="9" VerticalAlignment="Bottom" />
                            </Grid>
                            <Viewbox Grid.Column="1" Height="60" Stretch="Fill">
                                <Canvas Width="300" Height="60">
                                    <Polyline Points="{Binding StatsPbProgressionChartPoints}" Stroke="{StaticResource BrassDimBrush}" StrokeThickness="1.5"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <ItemsControl ItemsSource="{Binding StatsPbProgressionChartMarkers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X, Converter={StaticResource CenterOnCanvasPointConverter}, ConverterParameter=8}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Y, Converter={StaticResource CenterOnCanvasPointConverter}, ConverterParameter=8}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type engine:PbChartMarker}">
                                                <Ellipse Width="8" Height="8" Stroke="{StaticResource BackgroundBrush}" StrokeThickness="1.5">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPb}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource ToxicBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                    <Ellipse.ToolTip>
                                                        <TextBlock FontSize="11">
                                                            <Run Text="{Binding DateText}" />
                                                            <Run Text=" — " />
                                                            <Run Text="{Binding TimeText}" FontWeight="Bold" />
                                                        </TextBlock>
                                                    </Ellipse.ToolTip>
                                                </Ellipse>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding StatsPbProgressionRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type engine:PbMilestoneRow}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PBDate" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PBTime" MinWidth="20" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="PBImprovement" MinWidth="20" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock theme:UiRole.Name="PbDate" Grid.Column="0" Text="{Binding DateText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <TextBlock theme:UiRole.Name="PbTime" Grid.Column="1" Text="{Binding TimeText}" Foreground="{StaticResource ToxicBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" />
                                        <TextBlock theme:UiRole.Name="PbImprovement" Grid.Column="2" Text="{Binding ImprovementText}" Foreground="{StaticResource TextDimBrush}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Attempts Reached" Style="{StaticResource SectionHeader}" Margin="0,20,0,4" />
                        <TextBlock theme:UiRole.Name="Hint" Text="How far attempts typically get before ending — a practice signal for where runs tend to stop, without needing death-cause detail."
                                   Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock theme:UiRole.Name="EmptyState" Text="No attempts recorded yet for this category." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="11"
                                   Visibility="{Binding StatsAttemptsReachedRows, Converter={StaticResource EmptyCollectionToVisibilityConverter}}" />
                        <ItemsControl ItemsSource="{Binding StatsAttemptsReachedRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type engine:AttemptsReachedRow}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ARLocation" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="AREnded" MinWidth="20" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="ARFinished" MinWidth="20" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock theme:UiRole.Name="TableLabel" Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,16,0" />
                                        <TextBlock theme:UiRole.Name="TableNumber" Grid.Column="1" Text="{Binding TotalCount, StringFormat={}{0} ended here}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" Margin="0,0,16,0" />
                                        <TextBlock theme:UiRole.Name="TableNumber" Grid.Column="2" Text="{Binding CompletedCount, StringFormat={}{0} finished}" Foreground="{StaticResource ToxicBrush}" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Load &amp; Cutscene Overhead" Style="{StaticResource SectionHeader}" Margin="0,20,0,4" />
                        <TextBlock theme:UiRole.Name="Hint" Text="Total time spent loading or in cutscenes, across every attempt with the data to compute it."
                                   Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock theme:UiRole.Name="BodyText" Text="{Binding StatsLoadCutsceneOverheadText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Session Behavior" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding PauseStopsTime, Mode=TwoWay}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Pause Stops Time" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="Off by default — alt-tab won't freeze the adjusted timers" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                    <TextBlock theme:UiRole.Name="HintWarning" Text="Enabling this will make times ineligible for leaderboard submission unless the ruleset explicitly allows pausing."
                                               Foreground="{StaticResource WarningBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AutoResetOnLobbyReturn, Mode=TwoWay}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Auto-Reset on Lobby Return" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="On by default — timers reset the moment you're back in the lobby" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding PlaySoundOnNewPb, Mode=TwoWay}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Play Sound on New PB" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="On by default — a sound plays when you beat your full-run personal best." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button theme:UiRole.Name="RowButton" Content="Test" Style="{StaticResource ThemedButton}" Padding="10,4" FontSize="11" Click="TestPbSound_Click" />
                                    <Button theme:UiRole.Name="RowButton" Content="Browse..." Style="{StaticResource ThemedButton}" Padding="10,4" FontSize="11" Margin="6,0,0,0" Click="BrowsePbSound_Click" />
                                    <Button theme:UiRole.Name="RowButton" Content="Clear" Style="{StaticResource ThemedButton}" Padding="10,4" FontSize="11" Margin="6,0,0,0"
                                            Click="ClearPbSound_Click"
                                            Visibility="{Binding PbSoundPath, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="PB Sound" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="FileName" Text="{Binding PbSoundName}" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock theme:UiRole.Name="SettingValue" DockPanel.Dock="Right" Text="{Binding PbSoundVolume, StringFormat={}{0:P0}}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock theme:UiRole.Name="SettingName" Text="PB Sound Volume" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1" Value="{Binding PbSoundVolume, Mode=TwoWay}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <CheckBox x:Name="SoftwareRenderingCheckBox" DockPanel.Dock="Right" Checked="SoftwareRendering_Changed" Unchecked="SoftwareRendering_Changed" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Software Rendering" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="On by default — avoids overlay freezes when the game is GPU-bound; turn off only if your bottleneck is CPU instead. Requires restart." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding RunAtStartup, Mode=TwoWay}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Run at Startup" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="Off by default — launches Abyssplit (minimized to the tray) when you sign in to Windows." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AlwaysShowOverlay, Mode=TwoWay}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Always Show Overlay" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="Off by default — the overlay only shows while attached to the game, or while this window is open. Turn on to keep it visible all the time." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <CheckBox x:Name="ResetRunHotkeyCheckBox" DockPanel.Dock="Right" Checked="ResetRunHotkey_Changed" Unchecked="ResetRunHotkey_Changed" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Reset Run Hotkey" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="Off by default — Ctrl+Alt+R resets the run from anywhere, even while the game has focus. Same &quot;only outside a run&quot; guard as the Reset Run button." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Display" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowRawTimer, Mode=TwoWay}" VerticalAlignment="Center" />
                                <TextBlock theme:UiRole.Name="SettingName" Text="IGT Timer Card" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowLoadFreeTimer, Mode=TwoWay}" VerticalAlignment="Center" />
                                <TextBlock theme:UiRole.Name="SettingName" Text="Load-Free Timer Card" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowLoadCutsceneFreeTimer, Mode=TwoWay}" VerticalAlignment="Center" />
                                <TextBlock theme:UiRole.Name="SettingName" Text="Load+Cutscene-Free Timer Card" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowPreviousSegment, Mode=TwoWay}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Previous Segment" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="Controls both the overlay's Prev. Run row and the line below the splits list" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="History Storage" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AutoDeleteRunHistory, Mode=TwoWay}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Auto-Delete Old Runs" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="On by default — keeps run history from growing forever. Your PB run is never deleted. Turn off to keep every attempt permanently." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}"
                                Visibility="{Binding AutoDeleteRunHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" MinWidth="70" VerticalAlignment="Center"
                                          ItemsSource="{Binding AllRunHistoryLimits}" SelectedItem="{Binding RunHistoryLimit, Mode=TwoWay}" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Keep Up To" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="Per category and player count — practicing Any% doesn't trim your All Bosses history." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}"
                                Visibility="{Binding AutoDeleteRunHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" MinWidth="90" VerticalAlignment="Center"
                                          ItemsSource="{Binding AllRunHistoryTrimStrategies}" SelectedItem="{Binding RunHistoryTrimStrategy, Mode=TwoWay}" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Delete" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="Oldest: removes your earliest attempts first. Slowest: removes your worst times first, keeping recent history." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Personal Best" Style="{StaticResource SectionHeader}" />
                        <TextBlock theme:UiRole.Name="EmptyState" Text="No PB recorded yet for this category." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="11"
                                   Visibility="{Binding HasBestRunTime, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <Border Style="{StaticResource ToggleRow}"
                                Visibility="{Binding HasBestRunTime, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DockPanel>
                                <Button theme:UiRole.Name="RowButton" DockPanel.Dock="Right" Content="Delete PB" Style="{StaticResource ThemedButton}"
                                        Padding="10,4" FontSize="11" VerticalAlignment="Center"
                                        BorderBrush="{StaticResource DangerBrush}" Foreground="{StaticResource DangerTextBrush}"
                                        IsEnabled="{Binding IsInRun, Converter={StaticResource InverseBoolConverter}}"
                                        Click="DeletePersonalBest_Click" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Delete Recorded PB" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="If a bug ever records an impossible time, delete it here to revert to your next-fastest completed run." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="All Weapon%" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AllWeaponPreloadChecklist, Mode=TwoWay}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Show All 9 Weapons as a Checklist" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="Off by default — lists every weapon from the start and fills in each time as you go. Off: weapons appear in the order you play them." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding CountAllWeaponRunsAsAnyPercent, Mode=TwoWay}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Also Count Weapon Runs on Their Own" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="Off by default — when on, each weapon run is also saved on its own: as an Any% run in All Weapon%, or a True Ending run in All Weapon% True Ending (PB, gold splits, history). Takes effect from the next run." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Split Comparison" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" MinWidth="110" VerticalAlignment="Center"
                                          ItemsSource="{Binding AllComparisonSources}" SelectedItem="{Binding ComparisonSource, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource ComparisonSourceToDisplayNameConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Compare Splits Against" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="Best: your all-time best per floor. Previous: your immediately prior attempt. Specific Run: set below." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}"
                                Visibility="{Binding ComparisonSource, Converter={StaticResource ComparisonSourceToVisibilityConverter}, ConverterParameter=SpecificRun}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" MinWidth="220" MaxWidth="220" VerticalAlignment="Center"
                                          ItemsSource="{Binding AllHistoricalRuns}"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding SelectedHistoricalRunIndex, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type engine:HistoricalRunOption}">
                                            <TextBlock Text="{Binding PickerText}" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Specific Run to Compare Against" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="Only used when Split Comparison above is set to Specific Run" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button theme:UiRole.Name="RowButton" Content="Browse..." Style="{StaticResource ThemedButton}" Padding="10,4" FontSize="11" Click="BrowseImportSplitFile_Click" />
                                    <Button theme:UiRole.Name="RowButton" Content="Clear" Style="{StaticResource ThemedButton}" Padding="10,4" FontSize="11" Margin="6,0,0,0"
                                            Click="ClearImportSplitFile_Click"
                                            Visibility="{Binding HasImportedSplitFile, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Import Split File" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="Load a .abysplit file someone shared with you to race against it — sets Split Comparison above to Imported File."
                                               Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                    <TextBlock theme:UiRole.Name="ImportedFile" Text="{Binding ImportedSplitDisplayText}" Foreground="{StaticResource ToxicBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding HasImportedSplitFile, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Support" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <Button theme:UiRole.Name="RowButton" x:Name="CheckForUpdatesButton" DockPanel.Dock="Right" Content="Check for Updates" Style="{StaticResource ThemedButton}"
                                        Padding="10,4" FontSize="11" VerticalAlignment="Center"
                                        Click="CheckForUpdates_Click" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Check for Updates" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="The app also checks once automatically at startup — this is just a manual re-check." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                    <TextBlock theme:UiRole.Name="UpdateCheckStatus" x:Name="CheckForUpdatesStatusText" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <Button theme:UiRole.Name="RowButton" DockPanel.Dock="Right" Content="Report an Issue" Style="{StaticResource ThemedButton}"
                                        Padding="10,4" FontSize="11" VerticalAlignment="Center"
                                        Click="ReportIssue_Click" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Report a Bug" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="Opens a GitHub issue with a recent log excerpt attached and reveals today's full log file in case more detail is needed." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <Button theme:UiRole.Name="RowButton" DockPanel.Dock="Right" Content="About" Style="{StaticResource ThemedButton}"
                                        Padding="10,4" FontSize="11" VerticalAlignment="Center"
                                        Click="About_Click" />
                                <TextBlock theme:UiRole.Name="SettingName" Text="About Abyssplit" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Overlay">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="EditOverlayToggle"
                                          Content="Edit Overlay Layout"
                                          Style="{StaticResource ThemedToggleButton}"
                                          HorizontalAlignment="Left"
                                          Click="EditOverlayToggle_Click" />
                            <ToggleButton Content="Preview"
                                          Style="{StaticResource ThemedToggleButton}"
                                          HorizontalAlignment="Left" Margin="8,0,0,0"
                                          IsChecked="{Binding IsPreviewingOverlay, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock theme:UiRole.Name="Hint" Text="Edit Overlay Layout: toggle on to drag the overlay into position; toggle off to return it to click-through. Preview: shows sample split data so you can see appearance changes without being in a run — also unlocks the settings below."
                                   Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <StackPanel IsEnabled="{Binding IsPreviewingOverlay}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                        <TextBlock Text="Overlay Appearance" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource ToggleRow}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock theme:UiRole.Name="SettingValue" DockPanel.Dock="Right" Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Background Opacity" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1" Value="{Binding OverlayOpacity, Mode=TwoWay}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock theme:UiRole.Name="SettingValue" DockPanel.Dock="Right" Text="{Binding OverlayScale, StringFormat={}{0:P0}}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Overlay Size" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                </DockPanel>
                                <Slider Minimum="0.5" Maximum="2" Value="{Binding OverlayScale, Mode=TwoWay}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button theme:UiRole.Name="RowButton" Content="Browse..." Style="{StaticResource ThemedButton}" Padding="10,4" FontSize="11" Click="BrowseBackgroundImage_Click" />
                                    <Button theme:UiRole.Name="RowButton" Content="Clear" Style="{StaticResource ThemedButton}" Padding="10,4" FontSize="11" Margin="6,0,0,0"
                                            Click="ClearBackgroundImage_Click"
                                            Visibility="{Binding OverlayBackgroundImagePath, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Background Image" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="FileName" Text="{Binding OverlayBackgroundImagePath, Converter={StaticResource PathToFileNameConverter}}"
                                               Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="Section Styling" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding OverlayTimesHaveBackground, Mode=TwoWay}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Times Have a Background" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="Off by default — draws a small highlighted pill behind every time value (Biome/Depth/Floor/Weapon)." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource ToggleRow}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock theme:UiRole.Name="SettingValue" DockPanel.Dock="Right" Text="{Binding OverlayTitleFontSize, StringFormat={}{0:F0}pt}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock theme:UiRole.Name="StyleSectionName" Text="Title" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                </DockPanel>
                                <Slider Minimum="8" Maximum="24" Value="{Binding OverlayTitleFontSize, Mode=TwoWay}" Margin="0,8,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource BrassBrush}" Tag="OverlayTitleTextColor|#C98F3F" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TealGlowBrush}" Tag="OverlayTitleTextColor|#3FD6C0" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource ToxicBrush}" Tag="OverlayTitleTextColor|#C7FF3D" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource MagentaBrush}" Tag="OverlayTitleTextColor|#D94F9A" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TextPrimaryBrush}" Tag="OverlayTitleTextColor|#ECE3D0" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TextMutedBrush}" Tag="OverlayTitleTextColor|#8A9994" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorPickerSwatch}" Tag="OverlayTitleTextColor" Click="OpenColorPicker_Click"
                                            Background="{Binding OverlayTitleTextColor, Converter={StaticResource HexColorToBrushConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ToggleRow}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock theme:UiRole.Name="SettingValue" DockPanel.Dock="Right" Text="{Binding OverlayBiomeFontSize, StringFormat={}{0:F0}pt}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock theme:UiRole.Name="StyleSectionName" Text="Biome" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                </DockPanel>
                                <Slider Minimum="8" Maximum="24" Value="{Binding OverlayBiomeFontSize, Mode=TwoWay}" Margin="0,8,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource BrassBrush}" Tag="OverlayBiomeTextColor|#C98F3F" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TealGlowBrush}" Tag="OverlayBiomeTextColor|#3FD6C0" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource ToxicBrush}" Tag="OverlayBiomeTextColor|#C7FF3D" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource MagentaBrush}" Tag="OverlayBiomeTextColor|#D94F9A" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TextPrimaryBrush}" Tag="OverlayBiomeTextColor|#ECE3D0" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TextMutedBrush}" Tag="OverlayBiomeTextColor|#8A9994" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorPickerSwatch}" Tag="OverlayBiomeTextColor" Click="OpenColorPicker_Click"
                                            Background="{Binding OverlayBiomeTextColor, Converter={StaticResource HexColorToBrushConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ToggleRow}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock theme:UiRole.Name="SettingValue" DockPanel.Dock="Right" Text="{Binding OverlayDepthFontSize, StringFormat={}{0:F0}pt}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock theme:UiRole.Name="StyleSectionName" Text="Depth" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                </DockPanel>
                                <Slider Minimum="8" Maximum="24" Value="{Binding OverlayDepthFontSize, Mode=TwoWay}" Margin="0,8,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource BrassBrush}" Tag="OverlayDepthTextColor|#C98F3F" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TealGlowBrush}" Tag="OverlayDepthTextColor|#3FD6C0" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource ToxicBrush}" Tag="OverlayDepthTextColor|#C7FF3D" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource MagentaBrush}" Tag="OverlayDepthTextColor|#D94F9A" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TextPrimaryBrush}" Tag="OverlayDepthTextColor|#ECE3D0" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TextMutedBrush}" Tag="OverlayDepthTextColor|#8A9994" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorPickerSwatch}" Tag="OverlayDepthTextColor" Click="OpenColorPicker_Click"
                                            Background="{Binding OverlayDepthTextColor, Converter={StaticResource HexColorToBrushConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ToggleRow}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock theme:UiRole.Name="SettingValue" DockPanel.Dock="Right" Text="{Binding OverlayFloorFontSize, StringFormat={}{0:F0}pt}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock theme:UiRole.Name="StyleSectionName" Text="Floor" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                </DockPanel>
                                <Slider Minimum="8" Maximum="24" Value="{Binding OverlayFloorFontSize, Mode=TwoWay}" Margin="0,8,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource BrassBrush}" Tag="OverlayFloorTextColor|#C98F3F" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TealGlowBrush}" Tag="OverlayFloorTextColor|#3FD6C0" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource ToxicBrush}" Tag="OverlayFloorTextColor|#C7FF3D" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource MagentaBrush}" Tag="OverlayFloorTextColor|#D94F9A" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TextPrimaryBrush}" Tag="OverlayFloorTextColor|#ECE3D0" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TextMutedBrush}" Tag="OverlayFloorTextColor|#8A9994" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorPickerSwatch}" Tag="OverlayFloorTextColor" Click="OpenColorPicker_Click"
                                            Background="{Binding OverlayFloorTextColor, Converter={StaticResource HexColorToBrushConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ToggleRow}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock theme:UiRole.Name="SettingValue" DockPanel.Dock="Right" Text="{Binding OverlayWeaponFontSize, StringFormat={}{0:F0}pt}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock theme:UiRole.Name="StyleSectionName" Text="Weapon (All Weapon%)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                </DockPanel>
                                <Slider Minimum="8" Maximum="24" Value="{Binding OverlayWeaponFontSize, Mode=TwoWay}" Margin="0,8,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource BrassBrush}" Tag="OverlayWeaponTextColor|#C98F3F" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TealGlowBrush}" Tag="OverlayWeaponTextColor|#3FD6C0" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource ToxicBrush}" Tag="OverlayWeaponTextColor|#C7FF3D" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource MagentaBrush}" Tag="OverlayWeaponTextColor|#D94F9A" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TextPrimaryBrush}" Tag="OverlayWeaponTextColor|#ECE3D0" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TextMutedBrush}" Tag="OverlayWeaponTextColor|#8A9994" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorPickerSwatch}" Tag="OverlayWeaponTextColor" Click="OpenColorPicker_Click"
                                            Background="{Binding OverlayWeaponTextColor, Converter={StaticResource HexColorToBrushConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ToggleRow}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock theme:UiRole.Name="SettingValue" DockPanel.Dock="Right" Text="{Binding OverlayStatusFontSize, StringFormat={}{0:F0}pt}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <TextBlock theme:UiRole.Name="StyleSectionName" Text="Status" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                                </DockPanel>
                                <Slider Minimum="8" Maximum="24" Value="{Binding OverlayStatusFontSize, Mode=TwoWay}" Margin="0,8,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource BrassBrush}" Tag="OverlayStatusTextColor|#C98F3F" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TealGlowBrush}" Tag="OverlayStatusTextColor|#3FD6C0" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource ToxicBrush}" Tag="OverlayStatusTextColor|#C7FF3D" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource MagentaBrush}" Tag="OverlayStatusTextColor|#D94F9A" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TextPrimaryBrush}" Tag="OverlayStatusTextColor|#ECE3D0" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorSwatch}" Background="{StaticResource TextMutedBrush}" Tag="OverlayStatusTextColor|#8A9994" Click="ColorSwatch_Click" />
                                    <Button Style="{StaticResource ColorPickerSwatch}" Tag="OverlayStatusTextColor" Click="OpenColorPicker_Click"
                                            Background="{Binding OverlayStatusTextColor, Converter={StaticResource HexColorToBrushConverter}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button theme:UiRole.Name="RowButton" Content="Reset to Default" Style="{StaticResource ThemedButton}"
                                HorizontalAlignment="Left" Margin="0,4,0,0" Padding="10,4" FontSize="11"
                                Click="ResetOverlayAppearance_Click" />
                        </StackPanel>

                        <TextBlock Text="Split Display" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" MinWidth="100" VerticalAlignment="Center"
                                          ItemsSource="{Binding AllSplitDetailLevels}" SelectedItem="{Binding SplitDetailLevel, Mode=TwoWay}"
                                          IsEnabled="{Binding IsInRun, Converter={StaticResource InverseBoolConverter}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource SplitDetailLevelToDisplayNameConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="Split Detail Level" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="Total: no split list, just the timer. Per-Depth: one row per depth. Per-Room: also breaks out each depth's rooms — which depths depends on List Overflow Behavior below." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource ToggleRow}">
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Right" MinWidth="100" VerticalAlignment="Center"
                                          ItemsSource="{Binding AllSplitListOverflowBehaviors}" SelectedItem="{Binding SplitListOverflowBehavior, Mode=TwoWay}"
                                          IsEnabled="{Binding IsInRun, Converter={StaticResource InverseBoolConverter}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource SplitListOverflowBehaviorToDisplayNameConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel>
                                    <TextBlock theme:UiRole.Name="SettingName" Text="List Overflow Behavior" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                    <TextBlock theme:UiRole.Name="Hint" Text="Collapse: finished biomes fold to one line (and, in Per-Room, each depth's rooms fold once you're past it). Scroll: nothing folds, fixed-height, auto-scrolls to the current segment. Full List: nothing folds, no height cap, the overlay grows as needed." Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.RowSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button theme:UiRole.Name="CaptionButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets"
                    Tag="#1F2A26" Click="Minimize_Click" />
            <Button theme:UiRole.Name="CaptionButton" Style="{StaticResource CaptionButton}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                    Tag="#7A2E2E" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
